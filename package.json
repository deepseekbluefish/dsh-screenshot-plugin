{
    "name":  "dsh-screenshot-plugin",
    "version":  "1.0.1",
    "type":  "module",
    "description":  "WeChat-style in-app screenshot button for DeepSeek Harness: drag to capture a screen region, the PNG is saved with auto-numbering and copied to the Windows clipboard so Ctrl+V pastes it straight into the composer.",
    "license":  "MIT",
    "keywords":  [
                     "deepseek",
                     "harness",
                     "dsh",
                     "dsh-plugin",
                     "screenshot",
                     "capture",
                     "screen"
                 ],
    "files":  [
                  "lib",
                  "client",
                  "cordis.patch.yml",
                  "LICENSE",
                  "README.md",
                  "README.en.md"
              ],
    "exports":  {
                    ".":  "./lib/index.js",
                    "./package.json":  "./package.json",
                    "./client":  "./client/index.js"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [

                                          ],
                               "platform":  "web",
                               "immediately":  true
                           }
            },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/deepseekbluefish/dsh-screenshot-plugin.git"
                   }
}
